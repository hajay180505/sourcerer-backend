# Production (split-origin) environment. Copy to deploy/.env on the VM and fill
# in real values. Read by docker compose interpolation and by the portal
# container via env_file. NEVER commit the filled-in file.

# This VM's API hostname (no scheme). Its DNS A record must point at the VM and
# be DNS-only (grey cloud) so Caddy can complete the ACME challenge.
API_ADDRESS=api.sourcerer.ewhizard.tech

# Where the frontend is served from (Cloudflare Pages custom domain), with
# scheme. Used for CORS, the CSRF origin allow-list, and the post-OAuth redirect.
APP_ORIGIN=https://sourcerer.ewhizard.tech

# Managed Postgres (Neon). Take the connection string from the Neon dashboard
# and rewrite the scheme to postgresql+asyncpg://. Keep `?sslmode=require` —
# app/db/session.py translates it into asyncpg's ssl arg and drops the params
# asyncpg doesn't understand.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx-pooler.region.aws.neon.tech/sourcerer_portal?sslmode=require

# Google OAuth web client. Register BOTH of these on the client:
#   Authorized JavaScript origin:  <APP_ORIGIN>
#   Authorized redirect URI:       https://<API_ADDRESS>/api/v1/portal/auth/callback
GOOGLE_CLIENT_ID=1234-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123

# HS256 session-signing secret. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PORTAL_SESSION_SECRET=change-me-48-random-chars

# Comma-separated admin emails (approve requests, admin dashboard).
ADMIN_EMAILS=you@example.com

# Drive folder the portal catalogs (metadata only).
# The folder ID from its Drive URL: drive.google.com/drive/folders/<THIS>
PORTAL_ROOT_FOLDER_ID=your-drive-folder-id

# Optional tuning
PORTAL_SYNC_INTERVAL_MINUTES=360
PORTAL_SYNC_EXCLUDE=__pycache__,node_modules,venv,.venv,*.pyc
PORTAL_CONVERT_TIMEOUT_SECONDS=180
